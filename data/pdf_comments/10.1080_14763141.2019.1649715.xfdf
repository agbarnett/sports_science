><text color="#9643FC" creationdate="D:20251113130054+10'00'" flags="print,nozoom,norotate" inreplyto="761f95a4-33b9-43ea-b267-32c61e1bbd6c" date="D:20251113130054+10'00'" name="c61b872d-f1c5-4066-af35-f6b08cc48e46" icon="Comment" page="10" rect="59.616211,154.003830,83.616211,178.003830" subject="Sticky Note" title="Alexander Gibson"
><contents-richtext
><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:25.1.0" xfa:spec="2.0.2"
><p dir="ltr"
><span dir="ltr" style="font-size:-14.0pt;text-align:left;font-weight:normal;font-style:normal"
>Q14b: yes there were some practical reflections on the outcomes of the study</span
></p
