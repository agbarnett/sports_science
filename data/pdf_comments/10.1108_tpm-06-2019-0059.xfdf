><text color="#9643FC" creationdate="D:20251113110708+10'00'" flags="print,nozoom,norotate" inreplyto="dd7201fb-20f1-4fc6-b78b-c4a0edba17a0" date="D:20251113110708+10'00'" name="9197bce5-1182-4f0f-baf9-24a40bc9d27c" icon="Comment" page="11" rect="99.426376,413.091980,123.426376,437.091980" subject="Sticky Note" title="Alexander Gibson"
