><highlight color="#9643FC" opacity="0.399994" creationdate="D:20251112102418+10'00'" flags="print" IT="HighlightNote" date="D:20251112102428+10'00'" name="065e39b9-f494-4be0-a129-a253592934c9" page="9" coords="67.294500,290.948000,180.109000,290.948000,67.294500,280.896000,180.109000,280.896000" rect="66.980400,280.582000,180.423000,291.262000" subject="Comment on Text" title="alexd"
><contents-richtext
><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:25.1.0" xfa:spec="2.0.2"
