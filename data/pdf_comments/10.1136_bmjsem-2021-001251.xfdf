><highlight color="#9643FC" opacity="0.399994" creationdate="D:20250624104259+10'00'" flags="print" IT="HighlightNote" date="D:20250624104306+10'00'" name="5e7ebf16-19e0-4395-bbc6-98197b2ee944" page="5" coords="306.875000,529.041000,553.256000,529.041000,306.875000,517.261000,553.256000,517.261000,306.875000,517.041000,553.275000,517.041000,306.875000,505.261000,553.275000,505.261000,306.875000,505.041000,553.255000,505.041000,306.875000,493.261000,553.255000,493.261000,306.875000,493.041000,553.265000,493.041000,306.875000,481.261000,553.265000,481.261000,306.875000,481.041000,553.269000,481.041000,306.875000,469.261000,553.269000,469.261000,306.875000,469.041000,553.245000,469.041000,306.875000,457.261000,553.245000,457.261000,306.875000,457.041000,553.235000,457.041000,306.875000,445.261000,553.235000,445.261000,306.875000,445.041000,436.075000,445.041000,306.875000,433.261000,436.075000,433.261000" rect="306.507000,432.893000,553.643000,529.409000" subject="Comment on Text" title="alexd"
