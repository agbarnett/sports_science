><highlight color="#9643FC" opacity="0.399994" creationdate="D:20251113103913+10'00'" flags="print" IT="HighlightNote" date="D:20251113103927+10'00'" name="959a2428-0b98-4303-94f0-27f0aaed4a6f" page="7" coords="155.288000,604.103000,292.517000,604.103000,155.288000,592.543000,292.517000,592.543000,65.196800,592.083000,292.504000,592.083000,65.196800,580.523000,292.504000,580.523000,65.196800,580.063000,292.539000,580.063000,65.196800,568.503000,292.539000,568.503000,65.196800,568.103000,210.610000,568.103000,65.196800,556.543000,210.610000,556.543000" rect="64.835500,556.182000,292.901000,604.465000" subject="Comment on Text" title="Alexander Gibson"
