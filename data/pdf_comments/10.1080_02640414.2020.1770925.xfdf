0,323.439545,69.505508,322.839111,298.739441,322.839111,69.505508,311.420166,298.739441,311.420166,69.505508,310.820679,298.728943,310.820679,69.505508,299.401703,298.728943,299.401703,69.505508,298.858276,298.728210,298.858276,69.505508,287.439301,298.728210,287.439301,69.505508,286.839783,298.724426,286.839783,69.505508,275.420837,298.724426,275.420837,69.505508,274.820435,298.743317,274.820435,69.505508,263.401459,298.743317,263.401459,69.505508,262.858948,295.789612,262.858948,69.505508,251.440002,295.789612,251.440002" rect="58.773865,251.083160,299.103912,563.176758" subject="Comment on Text" title="Alexander Gibson"
