><text color="#9643FC" creationdate="D:20251112150346+10'00'" flags="print,nozoom,norotate" inreplyto="65ed2b81-3cf7-4549-be89-3f1a1a9d6657" date="D:20251112150346+10'00'" name="fc94d451-4afe-4d6f-a4c7-848277c1d2b7" icon="Comment" page="6" rect="316.558960,201.411102,340.558960,225.411102" subject="Sticky Note" title="alexd"
><contents-richtext
><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:25.1.0" xfa:spec="2.0.2"
><p dir="ltr"
><span dir="ltr" style="font-size:-14.0pt;text-align:left;font-weight:normal;font-style:normal"
