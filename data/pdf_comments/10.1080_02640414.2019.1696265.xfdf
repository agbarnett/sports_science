><highlight color="#9643FC" opacity="0.399994" creationdate="D:20251113112428+10'00'" flags="print" IT="HighlightNote" date="D:20251113112433+10'00'" name="aef4ec53-83a9-46db-94c3-73fd12ee4643" page="5" coords="48.018906,429.975586,298.765900,429.975586,48.018906,419.250092,298.765900,419.250092,48.018906,417.958069,298.694336,417.958069,48.018906,407.232605,298.694336,407.232605,48.018906,405.997559,298.653809,405.997559,48.018906,395.272095,298.653809,395.272095,48.018906,393.980103,298.760773,393.980103,48.018906,383.254608,298.760773,383.254608,48.018906,381.962585,298.789307,381.962585,48.018906,371.237091,298.789307,371.237091,48.018906,370.002075,298.634674,370.002075,48.018906,359.276611,298.634674,359.276611,48.018906,357.984558,298.669617,357.984558,48.018906,347.259094,298.669617,347.259094,48.018906,345.967102,128.787048,345.967102,48.018906,335.241608,128.787048,335.241608" rect="47.683731,334.906433,299.124481,430.310760" subject="Comment on Text" title="Alexander Gibson"
><contents-richtext
><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:25.1.0" xfa:spec="2.0.2"
><p dir="ltr"
><span dir="ltr" style="font-size:-14.0pt;text-align:left;color:#000000;font-weight:normal;font-style:normal"
