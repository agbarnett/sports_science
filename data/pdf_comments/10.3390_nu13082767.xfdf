><highlight color="#9643FC" opacity="0.399994" creationdate="D:20250529105655+10'00'" flags="print" IT="HighlightNote" date="D:20250529105704+10'00'" name="bb9ce267-ceb6-40bf-8544-1eb75bc5e574" page="17" coords="482.981934,456.814697,559.277344,456.814697,482.981934,444.600708,559.277344,444.600708,167.265015,444.261658,559.664917,444.261658,167.265015,432.047699,559.664917,432.047699,167.265015,431.708679,559.271179,431.708679,167.265015,419.494690,559.271179,419.494690,167.265015,419.155640,495.646057,419.155640,167.265015,406.941681,495.646057,406.941681" rect="166.883316,406.559998,560.046631,457.196411" subject="Comment on Text" title="alexd"
