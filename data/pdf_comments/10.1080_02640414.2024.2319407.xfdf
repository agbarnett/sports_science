><highlight color="#9643FC" opacity="0.399994" creationdate="D:20250709120406+10'00'" flags="print" IT="HighlightNote" date="D:20250709120411+10'00'" name="13d6b222-b54b-426d-b516-b0d427d59525" page="5" coords="310.734009,466.668945,561.428467,466.668945,310.734009,455.250000,561.428467,455.250000,310.734009,454.650513,561.439697,454.650513,310.734009,443.231537,561.439697,443.231537,310.734009,442.688110,561.437866,442.688110,310.734009,431.269165,561.437866,431.269165,310.734009,430.669678,336.516907,430.669678,310.734009,419.250702,336.516907,419.250702,336.554901,430.669678,354.363953,430.669678,336.554901,418.454865,354.363953,418.454865,358.524994,430.668945,448.691956,430.668945,358.524994,419.250000,448.691956,419.250000" rect="310.377167,418.073151,561.796509,467.025787" subject="Comment on Text" title="Alexander Gibson"
