><highlight color="#9643FC" opacity="0.399994" creationdate="D:20250630111651+10'00'" flags="print" IT="HighlightNote" date="D:20250630111706+10'00'" name="d6924da3-8347-4822-8c09-7557b13f6d8d" page="5" coords="530.762390,591.868530,575.933044,591.868530,530.762390,580.838562,575.933044,580.838562,313.001495,580.870361,575.938232,580.870361,313.001495,569.840454,575.938232,569.840454,313.001495,569.872314,575.941467,569.872314,313.001495,558.842346,575.941467,558.842346,313.001495,558.874146,371.662109,558.874146,313.001495,547.844238,371.662109,547.844238" rect="312.656799,547.499512,576.286133,592.213257" subject="Comment on Text" title="alexd"
