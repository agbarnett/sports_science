><text color="#9643FC" creationdate="D:20251010121638+10'00'" flags="print,nozoom,norotate" inreplyto="f15c9718-e272-4149-9d76-3239040985d6" date="D:20251010121638+10'00'" name="b731fa45-03dd-46ce-a7e6-566e858098c2" icon="Comment" page="7" rect="37.669159,345.793762,61.669159,369.793762" subject="Sticky Note" title="alexd"
