><highlight color="#9643FC" opacity="0.399994" creationdate="D:20250701085730+10'00'" flags="print" IT="HighlightNote" date="D:20250701085743+10'00'" name="429ec47c-b41f-4a7f-b89f-6de336ec0c57" page="8" coords="106.106689,399.220123,289.033600,399.220123,106.106689,384.130249,289.033600,384.130249,51.023590,386.720123,289.276398,386.720123,51.023590,371.630249,289.276398,371.630249,51.023590,374.220123,289.276520,374.220123,51.023590,359.130249,289.276520,359.130249" rect="50.552032,358.658691,289.748077,399.691681" subject="Comment on Text" title="Alexander Gibson"
