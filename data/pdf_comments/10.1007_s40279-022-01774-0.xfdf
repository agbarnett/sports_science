><text color="#9643FC" creationdate="D:20250630092838+10'00'" flags="print,nozoom,norotate" inreplyto="04132ccc-9928-496d-ac6f-0dbd95e0d8c3" date="D:20250630092838+10'00'" name="62138b74-8763-4d5c-b242-62924df73091" icon="Comment" page="16" rect="63.218887,339.915802,87.218887,363.915802" subject="Sticky Note" title="alexd"
