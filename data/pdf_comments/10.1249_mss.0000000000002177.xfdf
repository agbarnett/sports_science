><text color="#9643FC" creationdate="D:20250701093122+10'00'" flags="print,nozoom,norotate" inreplyto="4e3ff189-a77a-45b7-abc0-3cd145a52227" date="D:20250701093122+10'00'" name="2b55f672-9a10-4469-a6ff-123dedd38883" icon="Comment" page="2" rect="41.105682,303.215027,65.105682,327.215027" subject="Sticky Note" title="Alexander Gibson"
><contents-richtext
><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:25.1.0" xfa:spec="2.0.2"
><p dir="ltr"
><span dir="ltr" style="font-size:-14.0pt;text-align:left;font-weight:normal;font-style:normal"
