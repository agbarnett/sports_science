><highlight color="#9643FC" opacity="0.399994" creationdate="D:20251112101650+10'00'" flags="print" IT="HighlightNote" date="D:20251112101719+10'00'" name="68db8a91-5518-41fd-a48d-df636687ac0e" page="0" coords="355.726807,367.166931,553.298523,367.166931,355.726807,356.366943,553.298523,356.366943,355.726807,356.168945,553.276733,356.168945,355.726807,345.368958,553.276733,345.368958,355.726776,345.170959,553.272034,345.170898,355.726776,334.370972,553.272034,334.370911,355.726807,334.172913,553.279297,334.172913,355.726807,323.372925,553.279297,323.372925,355.726807,323.174927,553.272888,323.174927,355.726807,312.374939,553.272888,312.374939,355.726807,312.176941,553.282715,312.176941,355.726807,301.376953,553.282715,301.376953,355.726807,301.178955,553.285034,301.178955,355.726807,290.378967,553.285034,290.378967,355.726807,290.180969,553.278931,290.180969,355.726807,279.380981,553.278931,279.380981,355.726807,279.182983,553.281250,279.182983,355.726807,268.382996,553.281250,268.382996,355.726807,268.184998,451.360474,268.184998,355.726807,257.385010,451.360474,257.385010" rect="355.389282,257.047485,553.636047,367.504456" subject="Comment on Text" title="alexd"
