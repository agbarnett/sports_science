><highlight color="#9643FC" opacity="0.399994" creationdate="D:20250709132405+10'00'" flags="print" IT="HighlightNote" date="D:20250709132425+10'00'" name="bb7b8958-e242-4204-9bba-0c91b3249024" page="9" coords="45.354309,217.939178,289.156372,217.939178,45.354309,205.159332,289.156372,205.159332,45.354309,206.437195,289.141235,206.437195,45.354309,193.657349,289.141235,193.657349,45.354309,194.935181,289.137329,194.935181,45.354309,182.155334,289.137329,182.155334,45.354309,183.433197,289.104492,183.433197,45.354309,170.653351,289.104492,170.653351,45.354309,171.931183,289.110596,171.931183,45.354309,159.151337,289.110596,159.151337,45.354309,160.429199,289.137329,160.429199,45.354309,147.649353,289.137329,147.649353,45.354309,148.927185,289.139404,148.927185,45.354309,136.147339,289.139404,136.147339,45.354309,137.425201,289.153717,137.425201,45.354309,124.645355,289.153717,124.645355,45.354309,125.923187,289.116577,125.923187,45.354309,113.143341,289.116577,113.143341,45.354309,114.421188,289.137329,114.421188,45.354309,101.641342,289.137329,101.641342,45.354309,102.919189,289.161865,102.919189,45.354309,90.139343,289.161865,90.139343,45.354309,91.417191,289.139099,91.417191,45.354309,78.637344,289.139099,78.637344,45.354309,79.915192,289.133911,79.915192,45.354309,67.135345,289.133911,67.135345,45.354309,68.413193,246.019684,68.413193,45.354309,55.633347,246.019684,55.633347" rect="44.954941,55.233978,289.561218,218.338547" subject="Comment on Text" title="Alexander Gibson"
><contents-richtext
><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:25.1.0" xfa:spec="2.0.2"
><p dir="ltr"
><span dir="ltr" style="font-size:-14.0pt;text-align:left;color:#000000;font-weight:normal;font-style:normal"
>Q14c: </span
><span dir="ltr" style="font-size:-12.0pt;text-align:left;color:#000000;font-weight:normal;font-style:normal"
>Injury occurrences are common in athletes participating in&#xD;HPS. Injury burden was higher in females and seen to increase&#xD;as athletes progressed along the pathway into more elite levels&#xD;of competition and training. Deselection due to poor performance&#xD;was the main attrition factor, with more than half the&#xD;deselected athletes impacted by injury prior to deselection.&#xD;This highlights the indirect negative influence injury has on&#xD;athlete retention and demonstrates a need for implementing&#xD;injury prevention strategies in HPS pathway programs. This&#xD;study also demonstrates how using systems thinking frameworks&#xD;can be used to better understand the efficacy of pathway&#xD;programs and improve athlete retention and pathway progression&#xD;strategies.</span
></p
></body
></contents-richtext
><popup flags="print,nozoom,norotate" open="no" page="9" rect="595.276001,125.939178,779.276001,217.939178"
/></highlight
><text color="#9643FC" creationdate="D:20250709132439+10'00'" flags="print,nozoom,norotate" inreplyto="c0bf4a66-16d7-47e7-8e34-fad0ef66e6c6" date="D:20250709132439+10'00'" name="8b8edd9e-851b-4985-b06e-df8b23068a13" icon="Comment" page="9" rect="75.101501,218.448990,99.101501,242.448990" subject="Sticky Note" title="Alexander Gibson"
